# --- secrets (never commit) ---
.env
*.token

# --- large local data: corpus.db is ~2.3 GB and machine-specific; the vector
# index is derived (rebuildable); case artifacts contain dossier-derived data ---
data/
*.db
*.db-shm
*.db-wal
*.npy
*.f16

# --- logs and run artifacts (contain local filesystem paths) ---
*.log

# --- python / tooling caches ---
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.ruff_cache/
.venv/

# --- OS noise ---
Thumbs.db
Desktop.ini
